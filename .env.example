# Required only by the configurator. Use a dedicated CAM user/key with the minimum
# permissions required to manage this PoC's OIDC provider/role plus sts:GetCallerIdentity.
TENCENT_SECRET_ID=AKID_REPLACE_ME
TENCENT_SECRET_KEY=REPLACE_ME

# STS APIs require a region header. ap-singapore is only a PoC default; choose a supported region.
TENCENT_REGION=ap-singapore

# OIDC trust settings. The token issuer claim must exactly match OIDC_ISSUER.
# This PoC intentionally uploads the verification JWKS directly to Tencent and does not expose a JWKS endpoint.
OIDC_PROVIDER_NAME=custom-jwt-poc
OIDC_ISSUER=https://example.com/tencent-oidc-poc
OIDC_AUDIENCE=tencent-custom-jwt-poc
OIDC_SUBJECT=poc-workload
TENCENT_ROLE_NAME=CustomJwtPocRole

JWT_LIFETIME_SECONDS=300
TENCENT_SESSION_DURATION_SECONDS=1800
